        {
          "name": "POST Add Item - Valid Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();\r\n\r\npm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Success message is correct\", function () {\r\n    pm.expect(data.message).to.eql(\"Item added successfully\");\r\n});\r\n\r\npm.test(\"Player ID is correct\", function () {\r\n    pm.expect(data.playerId).to.eql(1001);\r\n});\r\n\r\npm.test(\"Item ID is correct\", function () {\r\n    pm.expect(data.item.itemId).to.eql(4);\r\n});\r\n\r\npm.test(\"Item name is correct\", function () {\r\n    pm.expect(data.item.name).to.eql(\"Mana Potion\");\r\n});\r\n\r\npm.test(\"Item quantity is correct\", function () {\r\n    pm.expect(data.item.quantity).to.eql(3);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"itemId\": 4,\r\n    \"name\": \"Mana Potion\",\r\n    \"quantity\": 3\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3000/players/1001/inventory",
