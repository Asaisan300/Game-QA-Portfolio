        {
          "name": "POST Add Item - Missing Name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Invalid item is rejected\", function () {\r\n    pm.response.to.have.status(400);\r\n});\r\n\r\npm.sendRequest(\r\n    \"http://localhost:3000/players/1003/inventory\",\r\n    function (err, response) {\r\n\r\n        if (err) {\r\n            pm.test(\"Inventory state can be retrieved\", function () {\r\n                pm.expect.fail(\"Could not retrieve inventory\");\r\n            });\r\n            return;\r\n        }\r\n\r\n        const data = response.json();\r\n\r\n        const initialCount = Number(\r\n            pm.collectionVariables.get(\"initialInventoryCount\")\r\n        );\r\n\r\n        pm.test(\"Invalid request does not modify inventory\", function () {\r\n            pm.expect(data.inventory.length)\r\n                .to.eql(initialCount);\r\n        });\r\n    }\r\n);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest(\r\n    \"http://localhost:3000/players/1003/inventory\",\r\n    function (err, response) {\r\n\r\n        if (err) {\r\n            console.log(\"Error getting initial inventory:\", err);\r\n            return;\r\n        }\r\n\r\n        const data = response.json();\r\n\r\n        pm.collectionVariables.set(\r\n            \"initialInventoryCount\",\r\n            data.inventory.length\r\n        );\r\n\r\n        console.log(\r\n            \"Initial inventory count:\",\r\n            data.inventory.length\r\n        );\r\n    }\r\n);"
                ]
              }
            }
